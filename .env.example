# Copiar a .env y reemplazar TODOS los CHANGE_ME antes de usar.
POSTGRES_DB=nexora_dev
POSTGRES_USER=nexora_admin
POSTGRES_PASSWORD=CHANGE_ME_LOCAL_ONLY
POSTGRES_PORT=5432

# Herramientas administrativas (migraciones/seed). Sin valor por defecto.
DATABASE_URL=
DATABASE_ADMIN_URL=

# Runtime por capacidad. Nunca compartir con apps/api.
ORCHESTRATOR_DATABASE_URL=
ENCARGADO_DATABASE_URL=
DATABASE_API_URL=

# Pruebas destructivas/controladas. Definir solo al ejecutarlas.
TEST_DATABASE_URL=
ALLOW_DEV_SEED=false
