# ============================================================
#  .env.ci — Variables dummy para el CI de GitHub Actions
#
#  El runner del CI NO tiene el .env real (esta gitignored).
#  Sin estas variables, `docker compose config -q` falla porque
#  los compose.yaml usan ${VAR:?mensaje} que las hace obligatorias.
#
#  Este archivo tiene SOLO valores dummy — ningun secreto real.
#  El CI valida SINTAXIS de los compose, no levanta contenedores.
#
#  Si agregas una nueva variable ${VAR:?...} a un compose.yaml,
#  agregala aca tambien con un valor dummy.
# ============================================================

# Postgres
POSTGRES_USER=nexora_admin
POSTGRES_PASSWORD=ci_dummy_pg_pass
POSTGRES_DB=nexora_dev
POSTGRES_PORT=5432

# Redis
REDIS_PASSWORD=ci_dummy_redis_pass
REDIS_PORT=6379

# MinIO
MINIO_ROOT_USER=ci_dummy_minio_user
MINIO_ROOT_PASSWORD=ci_dummy_minio_pass
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# Qdrant
QDRANT_API_KEY=ci_dummy_qdrant_key
QDRANT_PORT=6333

# Traefik
TRAEFIK_DASHBOARD_AUTH=ci_dummy_traefik_auth
