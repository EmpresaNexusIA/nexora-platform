# ── apps/tienda · .env ──────────────────────────────────────────────
# DEMO sin backend (preview):
DEMO_MODE=true

# PRODUCCIÓN (Postgres del monorepo):
DEMO_MODE=false

# Base de datos (del .env raíz del repo — el contenedor postgres local)
DATABASE_URL=postgresql://nexora_admin:CHANGE_ME@127.0.0.1:5432/nexora_dev

# URL pública base de ESTA app (para links del checkout)
NEXT_PUBLIC_BASE_URL=https://tu-dominio.vercel.app

# ── MinIO (fotos de producto) — si falta, usa filesystem local ──
S3_ENDPOINT=http://127.0.0.1:9000
S3_BUCKET=productos
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME
S3_PUBLIC_URL=http://127.0.0.1:9000/productos

# ── Notificaciones al vendedor ──
# Canal principal: orchestrator de la plataforma (outbox → Telegram)
NEXORA_EVENTS_URL=http://127.0.0.1:3001
NEXORA_EVENTS_TOKEN=CHANGE_ME

# Fallback sin orchestrator: ntfy.sh
# (cada comercio tieneistructura ntfy_topic en su fila de comercios)
NTFY_URL=https://ntfy.sh

# ── Asistente de chat (Fase 2: proveedor LLM enchufable) ──
LLM_PROVIDER=none

# ── Autenticación del panel (/panel/*) — Fase 1.5 ──
# URL pública de apps/api (el /login del panel la usa para pedir el JWT.
#   En producción cross-dominio: panel.nexora.app → api.nexora.app y la
#   tienda fija su PROPIA cookie host-only vía /api/sesion).
NEXT_PUBLIC_API_URL=http://127.0.0.1:3001

# Clave PÚBLICA RS256 (la misma con la que apps/api FIRMA los JWT).
# Formato: el PEM de apps/api/keys/public.pem en UNA línea con \n,
# entre comillas dobles:
#   JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nMIIBIjANBgkqhkiG...\n-----END PUBLIC KEY-----\n"
# · Verificación pura: NUNCA va la clave PRIVADA en este proyecto.
# · En Vercel (demo) no hace falta: con DEMO_MODE=true el panel es abierto.
JWT_PUBLIC_KEY=""
